# Optional: forward every submitted lead to a webhook (Zapier, Make, n8n, Slack,
# a CRM endpoint, etc.). If unset, leads are logged to the server console only.
LEAD_WEBHOOK_URL=

# Optional: address shown as the notification recipient in the webhook payload.
LEAD_NOTIFY_EMAIL=kelly@arizonainternationalrealestate.com

# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
# Must be a real URL, e.g. https://unocreativeph.vercel.app
# If unset or malformed, the site falls back to Vercel's deployment URL and
# then to the default domain; the build will not fail either way.
NEXT_PUBLIC_SITE_URL=https://kellyrojas.com
