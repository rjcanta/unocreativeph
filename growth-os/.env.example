# ── Realtor Growth OS — environment ──────────────────────────────────────────
# Everything is optional for local Demo Mode. Copy to .env and adjust.

# SQLite file for local development (relative to growth-os/).
DATABASE_URL="file:./dev.db"

# "demo" (default): fictional workspace, simulated sends, no outbound traffic.
# "live": real outbound sends become *possible*, but only after every gate in
#         docs/automation-rules.md passes (workspace toggle, integration toggle,
#         consent, CAN-SPAM footer, verified provider capability).
APP_MODE="demo"

# "demo": a fixed demo user is signed in automatically and a banner says so.
# Production authentication is NOT implemented yet — see docs/deployment.md.
AUTH_MODE="demo"

# Optional: use a non-demo workspace created with `npm run workspace:create`.
# Still demo authentication — local use only.
WORKSPACE_SLUG=""

# Optional. When unset the AI layer uses deterministic mock outputs.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# 32-byte key (base64 or 64 hex chars) used to encrypt stored CRM credentials
# with AES-256-GCM. Required before saving any live HighLevel token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# Shared secret for the scheduled job runner endpoint (/api/cron/process-jobs).
CRON_SECRET=""

# HighLevel webhook verification. Paste the public key and header name from the
# official HighLevel webhook documentation. Without both, live webhooks are rejected.
GHL_WEBHOOK_PUBLIC_KEY=""
GHL_WEBHOOK_SIGNATURE_HEADER="x-wh-signature"
